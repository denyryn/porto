---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import WorkSection from "../components/WorkSection.astro";
import Banner from "../components/Banner.astro";
import Bio from "../components/Bio.astro";
import StackSection from "../components/StackSection.astro";
import ExperienceSection from "../components/ExperienceSection.astro";
import CredentialsSection from "../components/CredentialsSection.astro";
import SiteFooter from "../components/SiteFooter.astro";

/* Static by design: the SSR default is for future dynamic routes. */
export const prerender = true;
---

<BaseLayout>
  <Header />
  <main id="main">
    <WorkSection />
    <Banner word="SELECTED WORK" scale="selected-work" />
    <Bio />
    <Banner word="THE RECORD" scale="the-record" />
    <StackSection />
    <ExperienceSection />
    <CredentialsSection />
  </main>
  <SiteFooter />
</BaseLayout>
