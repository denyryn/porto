---
import OpeningStrip from "./OpeningStrip.astro";
import ProjectCard from "./ProjectCard.astro";
import { projects } from "../constants/projects";
---

<section
  id="work"
  aria-labelledby="work-title"
  class="shell pt-[28px] pb-[28px] md:pt-[43px] md:pb-[43px]"
>
  <OpeningStrip />

  <div class="project-grid mt-[43px]">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>

<style>
  /* Scoped media queries: a custom `wide:` breakpoint emits before Tailwind's
     `md:` block, so `md:grid-cols-2 wide:grid-cols-3` silently stays 2-up. */
  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 43px 22px;
  }

  @media (min-width: 768px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1200px) {
    .project-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

  }
</style>
