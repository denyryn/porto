---
import SectionHead from "./SectionHead.astro";
import { bio } from "../constants/site";
---

<section
  id="about"
  aria-labelledby="about-title"
  class="shell py-[28px] md:py-[43px]"
>
  <SectionHead id="about-title" label={bio.label} />

  <div data-reveal class="mt-[22px]">
    <p
      class="bio-copy max-w-[65ch] font-body text-[19px] leading-[1.3] tracking-[-0.01em] text-ink-black"
    >
      {bio.body}
    </p>
    <p
      class="mt-[14px] font-body text-[17px] leading-[1.25] tracking-[-0.01em] text-charcoal-deep"
    >
      {bio.byline}
    </p>
  </div>
</section>

<style>
  .bio-copy::first-letter {
    float: left;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 92px;
    line-height: 0.71;
    letter-spacing: -0.02em;
    padding-right: 7px;
    padding-top: 4px;
  }
</style>
