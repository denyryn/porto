---
import SectionHead from "./SectionHead.astro";
import { stack, stackTiers } from "../constants/profile";
---

<section id="stack" class="shell py-[28px] md:py-[43px]" aria-labelledby="stack-title">
  <SectionHead id="stack-title" label={stack.label} kicker={stack.kicker} note={stack.note} />

  <ul class="mt-[22px] border-t border-ink-black">
    {
      stackTiers.map((tier) => (
        <li
          data-reveal
          class="grid gap-[7px] border-b border-ink-black py-[17px] md:grid-cols-[170px_1fr] md:gap-x-[22px]"
        >
          <h3 class="font-body text-[14px] uppercase leading-none tracking-[0.14em] text-charcoal-deep md:pt-[2px]">
            {tier.tier}
          </h3>
          <ul class="skills flex flex-wrap items-baseline gap-x-[7px] gap-y-[2px] font-body text-[22px] leading-[1.18] tracking-[-0.025em] text-ink-black">
            {tier.skills.map((skill) => <li>{skill}</li>)}
          </ul>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .skills > li + li::before {
    content: "·";
    margin-right: 7px;
    color: var(--color-charcoal-deep);
  }
</style>
