---
import SectionHead from "./SectionHead.astro";
import { experience, roles } from "../constants/profile";
---

<section
  id="experience"
  class="shell py-[28px] md:py-[43px]"
  aria-labelledby="experience-title"
>
  <SectionHead
    id="experience-title"
    label={experience.label}
    kicker={experience.kicker}
  />

  <ol class="mt-[22px] border-t border-ink-black">
    {
      roles.map((role) => (
        <li
          data-reveal
          class="grid gap-x-[22px] gap-y-[10px] border-b border-ink-black py-[22px] md:grid-cols-[minmax(0,1fr)_auto]"
        >
          <div class="md:col-start-1 md:row-start-1">
            <h3 class="font-mid text-[24px] leading-[1.05] tracking-[-0.02em] text-ink-black">
              {role.role}
            </h3>
            <p class="mt-[6px] break-words font-body text-[17px] leading-[1.25] tracking-[-0.01em] text-ink-black">
              {role.org}
            </p>
          </div>
          <p class="font-body text-caption tabular-nums text-charcoal-deep md:col-start-2 md:row-start-1 md:whitespace-nowrap md:text-right">
            {role.dates}
          </p>
          <p class="font-body text-[16px] leading-[1.3] tracking-[-0.01em] text-ink-black md:col-span-2 md:max-w-[92ch]">
            {role.line}
          </p>
          <p class="font-body text-caption text-charcoal-deep md:col-span-2">
            {role.stack.join(" · ")}
          </p>
        </li>
      ))
    }
  </ol>

  <p class="mt-[17px] font-body text-[16px] leading-[1.3] text-charcoal-deep">
    {experience.earlier}
  </p>
</section>
