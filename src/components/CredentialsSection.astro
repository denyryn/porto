---
import SectionHead from "./SectionHead.astro";
import {
  certifications,
  credentials,
  education,
} from "../constants/profile";
---

<section
  id="credentials"
  class="shell py-[28px] md:py-[43px]"
  aria-labelledby="credentials-title"
>
  <SectionHead
    id="credentials-title"
    label={credentials.label}
    kicker={credentials.kicker}
  />

  <div class="mt-[22px] grid gap-[28px] border-t border-ink-black pt-[22px] md:grid-cols-[1fr_1.15fr] md:gap-x-[43px]">
    <div data-reveal>
      <h3 class="font-mid text-[24px] leading-[1.05] tracking-[-0.02em] text-ink-black">
        {education.award}
      </h3>
      <p class="mt-[7px] font-body text-[17px] leading-[1.25] text-ink-black">
        {education.school} · {education.years}
      </p>
      <p class="mt-[3px] font-body text-caption text-charcoal-deep">
        {education.gpa}
      </p>
    </div>

    <ul class="border-t border-ink-black md:border-t-0">
      {
        certifications.map((certification) => (
          <li
            data-reveal
            class="flex flex-wrap items-baseline justify-between gap-x-[14px] gap-y-[2px] border-b border-ink-black py-[10px]"
          >
            <span class="font-body text-[17px] leading-[1.2] text-ink-black">
              {certification.name}
            </span>
            <span class="font-body text-caption text-charcoal-deep">
              {certification.issuer} · {certification.date}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
